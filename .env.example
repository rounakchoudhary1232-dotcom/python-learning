# Server-side only. Never place secrets in NEXT_PUBLIC_ variables.
ENVIRONMENT=development
LOG_LEVEL=INFO
# SQLite makes the MVP runnable without Docker. Use the PostgreSQL URL below when Docker is running.
DATABASE_URL=sqlite:///./jarvis.db
# DATABASE_URL=postgresql+psycopg://jarvis:jarvis@localhost:5432/jarvis
REDIS_URL=redis://localhost:6379/0
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
AI_TIMEOUT_SECONDS=30
CONVERSATION_CONTEXT_MESSAGES=20
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
SESSION_HOURS=168
WORKSPACE_ROOT=./workspace
TRADING_MODE=PAPER
TRADING_INITIAL_BALANCE=10000
MAX_RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.03
MAX_TRADES_PER_DAY=5
MIN_CONFIDENCE=0.60
MIN_RISK_REWARD=1.5
MAX_DRAWDOWN=0.10
DATA_PROVIDER=simulated
