# Copy this file to .env for local development. Never commit real credentials.

# Frontend: only expose values intentionally prefixed with NEXT_PUBLIC_.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# API
JARVIS_ENVIRONMENT=development
JARVIS_CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+psycopg://jarvis:jarvis@postgres:5432/jarvis
REDIS_URL=redis://redis:6379/0
# Set only in the server/runtime environment when Phase 3 AI integration is enabled.
OPENAI_API_KEY=
